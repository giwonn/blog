# Loaded automatically by bun:test via symlinks in each workspace.
#
# Plan A uses the shared local dev Postgres from apps/api-next/docker-compose.yml
# for tests (since /health only runs SELECT 1 and has no state to isolate).
# Run `docker compose -f apps/api-next/docker-compose.yml up -d postgres` once
# before `bun test`.
#
# Plan B should revisit isolation strategy — options include transaction rollback
# per test, a separate test compose file on a different port, or Testcontainers
# (currently blocked on a bun runtime compatibility issue where the
# wait-for-ready loop hangs even though the container becomes healthy).
DATABASE_URL=postgresql://api_next:api_next_dev_pwd@localhost:5433/api_next_dev
ADMIN_JWT_SECRET=test-secret-test-secret-test-secret-test
ADMIN_GOOGLE_SUB=test-allowed-sub
NODE_ENV=test
LOG_LEVEL=fatal
BLOG_PORT=8080
ADMIN_PORT=8081
GITHUB_OWNER=test-owner
GITHUB_REPO=test-repo
