pipeline {
    agent any

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Changes') {
            steps {
                script {
                    def changes = sh(script: "git diff --name-only HEAD~1 || echo 'FIRST_BUILD'", returnStdout: true).trim()
                    if (!changes.contains('apps/admin/') && !changes.contains('package.json') && !changes.contains('bun.lock') && !changes.contains('FIRST_BUILD')) {
                        currentBuild.result = 'NOT_BUILT'
                        currentBuild.description = 'Skipped: no admin changes'
                        error('No relevant changes detected')
                    }
                }
            }
        }

        stage('Ensure Network') {
            steps {
                sh 'docker network create blog-network || true'
            }
        }

        stage('Blue-Green Deploy') {
            steps {
                sh 'chmod +x infra/scripts/deploy-frontend.sh && bash infra/scripts/deploy-frontend.sh admin'
            }
        }
    }

    post {
        success {
            echo 'Admin frontend deployment successful!'
        }
        failure {
            echo 'Admin frontend deployment failed!'
        }
    }
}
