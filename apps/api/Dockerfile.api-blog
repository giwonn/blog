# syntax=docker/dockerfile:1
FROM oven/bun:1.3.12-alpine AS build
WORKDIR /build

COPY package.json bun.lock ./
COPY apps/blog/package.json ./apps/blog/
COPY apps/admin/package.json ./apps/admin/
COPY apps/api/apps/blog/package.json ./apps/api/apps/blog/
COPY apps/api/apps/admin/package.json ./apps/api/apps/admin/
COPY apps/api/packages/core/package.json ./apps/api/packages/core/

RUN bun install --frozen-lockfile

COPY apps/api/apps/blog ./apps/api/apps/blog
COPY apps/api/packages/core ./apps/api/packages/core
COPY apps/api/tsconfig.base.json ./apps/api/

RUN cd apps/api/apps/blog && bun x tsc --noEmit

FROM oven/bun:1.3.12-alpine AS runtime
WORKDIR /app
COPY --from=build /build/node_modules ./node_modules
COPY --from=build /build/apps/api/apps/blog ./apps/api/apps/blog
COPY --from=build /build/apps/api/packages/core ./apps/api/packages/core
COPY --from=build /build/apps/api/tsconfig.base.json ./apps/api/
ENV NODE_ENV=production
EXPOSE 8080
CMD ["bun", "run", "--bun", "apps/api/apps/blog/src/index.ts"]
